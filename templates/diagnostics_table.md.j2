{% macro clean(text) -%}
{{ text | replace('&quot;', "'") | replace('&amp;#39;', "'") | replace('&amp;amp;#8217;', "'") | replace('&lsquo;', "'") | replace('&rsquo;', "'") | replace('&amp;gt;', '>') | replace('&gt;', '>') | replace('&lt;', '<') }}
{%- endmacro %}
{# solution entries whose id starts with "K" are KB articles; everything else
   is treated as a related-change id (see note near the Details loop below) #}
{% macro links_list(items) -%}
{% set ns = namespace(out=[]) -%}
{% for item in items -%}
{% if item.id.startswith('K') -%}
{% set ns.out = ns.out + ['[' + item.id + '](' + item.value + ')'] -%}
{% endif -%}
{% endfor -%}
{{ ns.out | join(', ') if ns.out | length > 0 else '—' }}
{%- endmacro %}
{% macro ids_list(items) -%}
{% set ns = namespace(out=[]) -%}
{% for item in items -%}
{% if not item.id.startswith('K') -%}
{% set ns.out = ns.out + ['ID ' + item.id] -%}
{% endif -%}
{% endfor -%}
{{ ns.out | join(', ') if ns.out | length > 0 else '—' }}
{%- endmacro %}
{% set tenable_findings = tenable_findings | default([]) -%}
{% macro tenable_cves(v) -%}
{% set c = v.plugin.cve | default([]) -%}
{{ (c if c is string else c | join(', ')) if c else '—' }}
{%- endmacro %}
